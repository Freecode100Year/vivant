# /etc/vivant.env — install.sh 会自动创建 · install.sh creates this for you.
# 改完执行 After editing:  systemctl restart vivant
# 全部参数 Full flag list:  vivant -h
# 旧名 PTT_* 仍然有效 · The pre-rename PTT_* names still work.

VIVANT_ADDR=:2222

# 只返回计数的健康检查（vivant-ctl status 用），只监听本机 · Counts-only health endpoint (used by "vivant-ctl status"). Keep it on localhost.
VIVANT_HEALTH_ADDR=127.0.0.1:2223

# 只对 Go 写的旧版本（v0.9.x 及更早）有效 · Only read by the Go releases (v0.9.x and earlier).
GOMEMLIMIT=600MiB

# 管理员公钥（authorized_keys 格式），服务要能读（0644）· Admin keys (authorized_keys format), readable by the service (mode 0644).
#VIVANT_ADMIN_KEYS=/etc/vivant/admins.pub

# 公共房间，第一个是大厅 · Public rooms, first one is the lobby.
#VIVANT_ROOMS=general:大厅 Lobby,chinese:中文频道,english:English,technology:技术,anonymous:随便聊

# 重启后保留封禁（可选）：会把地址哈希密钥存盘 · Keep bans across restarts (opt-in): stores the address-hash key on disk.
#VIVANT_BAN_FILE=/var/lib/vivant/bans.json

# 进入时额外显示的公告 · Extra welcome lines shown on connect.
#VIVANT_MOTD=/etc/vivant/motd.txt

# 其他参数 · Any other flags.
VIVANT_ARGS=-max-per-ip 3 -idle-timeout 1h
