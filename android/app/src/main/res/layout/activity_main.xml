<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/app_name"
                android:textColor="@color/accent"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="5dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            style="@style/Hint"
            android:layout_marginBottom="12dp"
            android:text="@string/subtitle" />

        <!-- 1. status + the one button -->
        <LinearLayout style="@style/Card">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/online"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tunnel_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/err"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/toggle"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:minHeight="60dp"
                android:textSize="18sp" />

            <Button
                android:id="@+id/battery"
                style="@style/BtnLight"
                android:layout_width="match_parent"
                android:layout_marginTop="4dp"
                android:text="@string/battery" />
        </LinearLayout>

        <!-- 2. how to connect -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Label"
                android:layout_marginTop="0dp"
                android:text="@string/connect_title" />

            <TextView
                style="@style/Hint"
                android:layout_marginTop="4dp"
                android:text="@string/connect_lan" />

            <TextView
                android:id="@+id/connect"
                style="@style/Mono" />

            <TextView
                android:id="@+id/net_hint"
                style="@style/Hint"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/net_connect"
                style="@style/Mono" />

            <Button
                android:id="@+id/copy"
                style="@style/Btn"
                android:layout_width="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/copy" />

            <TextView
                android:id="@+id/fingerprint"
                style="@style/Hint"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />
        </LinearLayout>

        <!-- 3. internet access: off / EasyTier -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Label"
                android:layout_marginTop="0dp"
                android:text="@string/net_title" />

            <RadioGroup
                android:id="@+id/tunnel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/tunnel_off"
                    style="@style/Radio"
                    android:text="@string/net_off" />

                <RadioButton
                    android:id="@+id/tunnel_et"
                    style="@style/Radio"
                    android:text="@string/net_et" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/et_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView style="@style/Hint" android:text="@string/et_hint" />

                <TextView style="@style/Label" android:text="@string/et_name" />
                <EditText
                    android:id="@+id/et_name"
                    style="@style/Field"
                    android:fontFamily="monospace"
                    android:importantForAutofill="no"
                    android:inputType="text|textNoSuggestions" />

                <TextView style="@style/Label" android:text="@string/et_secret" />
                <EditText
                    android:id="@+id/et_secret"
                    style="@style/Field"
                    android:fontFamily="monospace"
                    android:importantForAutofill="no"
                    android:inputType="text|textNoSuggestions" />

                <Button
                    android:id="@+id/et_new"
                    style="@style/BtnLight"
                    android:layout_width="wrap_content"
                    android:text="@string/et_new" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. advanced (folded) -->
        <TextView
            android:id="@+id/adv_toggle"
            style="@style/Fold"
            android:text="@string/adv_title" />

        <LinearLayout
            android:id="@+id/adv_group"
            style="@style/Card"
            android:visibility="gone">

            <TextView
                style="@style/Hint"
                android:text="@string/settings_locked" />

            <TextView style="@style/Label" android:text="@string/port" />
            <EditText
                android:id="@+id/port"
                style="@style/Field"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="5" />

            <TextView style="@style/Label" android:text="@string/max_clients" />
            <EditText
                android:id="@+id/max_clients"
                style="@style/Field"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="6" />

            <TextView style="@style/Label" android:text="@string/rooms" />
            <EditText
                android:id="@+id/rooms"
                style="@style/Field"
                android:hint="@string/rooms_hint"
                android:importantForAutofill="no"
                android:inputType="text" />

            <TextView style="@style/Label" android:text="@string/et_peer" />
            <EditText
                android:id="@+id/et_peer"
                style="@style/Field"
                android:fontFamily="monospace"
                android:hint="@string/et_peer_default"
                android:importantForAutofill="no"
                android:inputType="textUri" />

            <TextView style="@style/Label" android:text="@string/extra" />
            <EditText
                android:id="@+id/extra"
                style="@style/Field"
                android:fontFamily="monospace"
                android:hint="@string/extra_hint"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions" />

            <CheckBox
                android:id="@+id/autostart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/accent"
                android:minHeight="48dp"
                android:text="@string/autostart"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 5. log (folded) -->
        <TextView
            android:id="@+id/log_toggle"
            style="@style/Fold"
            android:text="@string/log_title" />

        <ScrollView
            android:id="@+id/log_scroll"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:background="@drawable/log_bg"
            android:nestedScrollingEnabled="true"
            android:visibility="gone">

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:textColor="@color/log_text"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </ScrollView>
    </LinearLayout>
</ScrollView>
